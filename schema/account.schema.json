{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mikumiku-jp/xgomi/blob/main/schema/account.schema.json",
  "title": "xgomi account entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "username",
    "categories",
    "evidence",
    "added_at",
    "updated_at"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "エディタで入力補完を効かせるための行。`../schema/account.schema.json` と書きます。"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{1,25}$",
      "description": "X の数値ユーザーID。ファイル名と同じ値にします。"
    },
    "username": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]{1,15}$",
      "description": "ユーザー名。@ は含めません。"
    },
    "display_name": {
      "type": "string",
      "maxLength": 100,
      "description": "表示名。省略できます。"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "ai-hype",
          "ai-slop",
          "undisclosed-ai",
          "fake-demo",
          "plagiarism",
          "content-farm",
          "impersonation",
          "affiliate-spam",
          "info-product",
          "undisclosed-promo",
          "scam",
          "engagement-farming",
          "rage-bait",
          "bot-automation",
          "adult-spam",
          "misinformation"
        ]
      },
      "description": "当てはまる行為。POLICY.md の定義から選びます。"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "description": "low=散発的 / medium=常習 / high=詐欺・実害あり"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "description": "証拠ツイート。最低1件。対象アカウント本人の投稿にかぎります。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://(x|twitter)\\.com/[A-Za-z0-9_]{1,15}/status/[0-9]{1,25}$",
            "description": "証拠ツイートのURL。"
          },
          "note": {
            "type": "string",
            "maxLength": 300,
            "description": "何が問題なのかの客観的な説明。"
          },
          "archive_url": {
            "type": "string",
            "format": "uri",
            "description": "魚拓のURL。ツイートが消されても証拠が残ります。自動で埋まるので、普段は書く必要はありません。"
          },
          "unavailable_since": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "書く必要はありません。"
          }
        }
      }
    },
    "note": {
      "type": "string",
      "maxLength": 1000,
      "description": "補足。行為の説明だけを書きます。人格攻撃・個人情報は書けません。"
    },
    "status": {
      "type": "string",
      "enum": [
        "listed",
        "username-changed",
        "suspended",
        "deleted",
        "delisted"
      ],
      "default": "listed",
      "description": "listed=掲載中 / delisted=掲載解除。通常は書かなくて構いません。"
    },
    "delisted_reason": {
      "type": "string",
      "maxLength": 300,
      "description": "掲載を解除した理由。status を delisted にするときに書きます。"
    },
    "username_history": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]{1,15}$"
      },
      "uniqueItems": true,
      "description": "過去のユーザー名。書く必要はありません。"
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "description": "関連する議論やまとめ記事のURL。"
    },
    "added_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "掲載した日。YYYY-MM-DD 形式。"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "最後に更新した日。YYYY-MM-DD 形式。"
    },
    "last_checked_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "書く必要はありません。"
    }
  }
}
